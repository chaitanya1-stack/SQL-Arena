DATABASE_URL=postgresql://arena:change-me@localhost:5432/arena
REDIS_URL=redis://localhost:6379
APP_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://localhost:4000
PORT=4000
NODE_ENV=development
COOKIE_SECURE=false
JUDGE_CONCURRENCY=2
JUDGE_QUERY_MS=3000
JUDGE_JOB_MS=120000
JUDGE_POSTGRES_IMAGE=sql-arena-postgres
JUDGE_MYSQL_IMAGE=sql-arena-mysql
TRUST_PROXY=false
# Docker Compose requires this. Use a long random value, not change-me.
POSTGRES_PASSWORD=
# Optional external integrations. No reset emails or OAuth until configured.
SMTP_URL=
MAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public API origin, usually the same origin as the frontend reverse proxy.
PUBLIC_ORIGIN=http://localhost:3000
