{
  "name": "sql-arena",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web 'node --watch --env-file-if-exists=.env --import tsx apps/api/server.ts' 'npm run dev -w apps/web'",
    "api": "node --env-file-if-exists=.env --import tsx apps/api/server.ts",
    "worker": "node --env-file-if-exists=.env --import tsx apps/worker/main.ts",
    "migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "admin": "node --env-file-if-exists=.env --import tsx scripts/admin.ts",
    "validate:bank": "node --env-file-if-exists=.env --import tsx scripts/validate-bank.ts",
    "check:content": "node --env-file-if-exists=.env --import tsx scripts/check-content.ts",
    "test": "node --env-file-if-exists=.env --import tsx --test tests/*.test.ts",
    "test:integration": "node --env-file-if-exists=.env --import tsx --test tests/integration/*.test.ts",
    "typecheck": "tsc --noEmit && npm run typecheck -w apps/web",
    "build": "npm run build -w apps/web",
    "load": "node scripts/load.mjs",
    "check:postgres:offline": "node --env-file-if-exists=.env --import tsx scripts/check-postgres-wasm.ts",
    "benchmark:judge": "node --env-file-if-exists=.env --import tsx scripts/benchmark-judge.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^6.1.2",
    "bullmq": "^5.61.0",
    "decimal.js": "^10.6.0",
    "fastify": "^5.6.1",
    "ioredis": "^5.8.1",
    "nodemailer": "^10.1.7",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.7.2",
    "@types/nodemailer": "^7.0.2",
    "@types/pg": "^8.15.5",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "type": "module"
}
